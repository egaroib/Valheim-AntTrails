<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Environment.props carries machine-specific paths (Steam install, Gale profile)
       and is deliberately not committed. It is generated by the valheim-mod skill's
       setup.sh; see Environment.props.example for the shape.

       Two layouts have to work: this mod checked out on its own, and this mod sitting
       inside a multi-mod workspace that already has a shared Environment.props two
       levels up. Prefer a local file, fall back to the workspace one. -->
  <Import Project="$(MSBuildThisFileDirectory)Environment.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Environment.props')" />
  <Import Project="$(MSBuildThisFileDirectory)../../Environment.props"
          Condition="'$(ValheimManaged)' == '' And Exists('$(MSBuildThisFileDirectory)../../Environment.props')" />

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- This file is imported before the SDK defines its default search paths, so
         $(AssemblySearchPaths) is still empty here. Appending to it would silently drop
         {HintPathFromItem} and every <HintPath> in the csproj would be ignored. List the
         tokens explicitly instead. -->
    <AssemblySearchPaths>{CandidateAssemblyFiles};{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName};$(ValheimManaged);$(OutDir)</AssemblySearchPaths>
    <!-- Game assemblies are unsigned and unversioned in the usual sense; quiet the noise. -->
    <NoWarn>$(NoWarn);CS0626;CS0649;MSB3277</NoWarn>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <Target Name="AssertEnvironment" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ValheimManaged)' == ''"
           Text="No Environment.props found. Copy Environment.props.example and fill in your paths." />
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')"
           Text="assembly_valheim.dll not found at $(ValheimManaged). Check the paths in Environment.props." />
  </Target>
</Project>
